# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings > API no dashboard do Supabase).
# NUNCA commite o .env.local — ele já está no .gitignore.

# Segura para expor no browser: a proteção real vem do RLS no banco.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# NUNCA prefixar com NEXT_PUBLIC_. Usada apenas em contexto server-side
# (ex: se algum dia precisar de uma rota admin ou job que bypassa RLS).
# Não é necessária para o funcionamento normal do app.
SUPABASE_SERVICE_ROLE_KEY=

# Usada pelo n8n (fora deste projeto) para ler/escrever tarefas via API.
# Configure como credencial no n8n, nunca neste repositório.
# N8N_FOCO_SERVICE_ROLE_KEY=

# Cobrança recorrente Stripe (somente no servidor; nunca use NEXT_PUBLIC_).
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ESSENTIAL_MONTHLY_PRICE_ID=
STRIPE_ESSENTIAL_YEARLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
